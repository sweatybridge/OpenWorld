# Required for agent bootstrap and model calls.
ATTOBOT_API_KEY=replace-me

# Optional tool key for SEARCH.
ATTOBOT_EXA_API_KEY=

# Shared model defaults seeded by agent-init.
ATTOBOT_MODEL=deepseek-v4-pro
ATTOBOT_API_BASE=https://api.deepseek.com/v1
ATTOBOT_TEMPERATURE=1.0
ATTOBOT_REASONING_EFFORT=medium
ATTOBOT_CONTEXT_TOKENS=1000000
ATTOBOT_MULTIMODAL_SUPPORT=false

# Telegram inbox configuration.
ATTOBOT_TELEGRAM_TOKEN=
ATTOBOT_TELEGRAM_CHAT_ID=
ATTOBOT_TELEGRAM_THREAD_ID=
ATTOBOT_TELEGRAM_API_BASE=https://api.telegram.org
ATTOBOT_TELEGRAM_POLL_TIMEOUT=60

# Dashboard auth and local DB password.
ATTOBOT_DASHBOARD_DB_PASSWORD=dashboard
ATTOBOT_DASHBOARD_TOKEN=
POSTGRES_PASSWORD=postgres
