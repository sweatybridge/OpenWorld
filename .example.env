# Required for agent bootstrap and model calls.
OPENWORLD_API_KEY=replace-me

# Optional tool key for SEARCH.
OPENWORLD_EXA_API_KEY=

# Shared model defaults seeded by agent-init.
OPENWORLD_MODEL=Gemma4-26B-A4B
OPENWORLD_API_BASE=http://localhost:11434/v1
OPENWORLD_TEMPERATURE=1.0
OPENWORLD_REASONING_EFFORT=medium
OPENWORLD_CONTEXT_TOKENS=131072
OPENWORLD_MULTIMODAL_SUPPORT=true

# Telegram inbox configuration.
OPENWORLD_TELEGRAM_TOKEN=
OPENWORLD_TELEGRAM_CHAT_ID=
OPENWORLD_TELEGRAM_THREAD_ID=
OPENWORLD_TELEGRAM_API_BASE=https://api.telegram.org
OPENWORLD_TELEGRAM_POLL_TIMEOUT=10

# Dashboard auth and local DB password.
OPENWORLD_DASHBOARD_PASSWORD=dashboard
OPENWORLD_DASHBOARD_TOKEN=
OPENWORLD_POSTGRES_PASSWORD=postgres

# SSH bash tool configuration.
OPENWORLD_SSH_HOST=sshd
OPENWORLD_SSH_PORT=2222
OPENWORLD_SSH_USER=OpenWorld
OPENWORLD_SSH_HOST_NAME=default
OPENWORLD_SSH_HOST_KEY_FINGERPRINT=
